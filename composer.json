{
    "name": "sohaibilyas/plunk-laravel",
    "description": "Laravel mail transport for Plunk with queue retry idempotency, attachments and self-hosted support.",
    "keywords": [
        "laravel",
        "plunk",
        "mail",
        "email",
        "transport",
        "transactional"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "marcelo",
            "email": "diagngo@gmail.com"
        },
        {
            "name": "Sohaib Ilyas",
            "homepage": "https://github.com/sohaibilyas",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SohaibIlyas\\PlunkLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SohaibIlyas\\PlunkLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SohaibIlyas\\PlunkLaravel\\PlunkServiceProvider"
            ],
            "aliases": {
                "Plunk": "SohaibIlyas\\PlunkLaravel\\Facades\\Plunk"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/sohaibilyas/plunk-laravel",
    "type": "library",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "conflict": {
        "marceloeatworld/plunk-laravel": "*",
        "nextmigrant/laravel-plunk": "*"
    }
}
